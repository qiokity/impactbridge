# Required for migrations and persistent application data.
DATABASE_URL="postgresql://impactbridge:change-me@localhost:5432/impactbridge?schema=public"

# Required to issue encrypted, HTTP-only application sessions.
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Optional. Bootstrap occurs only through the local seed command. Set both or neither.
INITIAL_ADMIN_EMAIL="admin@example.test"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-local-bootstrap-password"

# Required only by the development seed command. Never reuse a real password.
DEMO_SEED_PASSWORD="replace-with-a-development-only-password"

# Local storage is the safe default for development. Configure S3 only for deployment.
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Leave empty to use the clearly labelled simulated local payment adapter.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional transactional mail provider settings; development uses a safe server log adapter.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""
